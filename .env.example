# news-lens 환경변수.
#
# 로컬: 이 파일을 .env 로 복사해 채운다. .env 는 절대 커밋하지 않는다.
# 운영: 아래 이름 그대로 GitHub 레포의 Settings → Secrets and variables →
#       Actions → Secrets 에 등록한다. 워크플로가 이 이름으로 참조한다.
#
# 키가 하나도 없어도 모든 step 은 --dry-run 으로 돌아간다.
# fixtures 로 전체를 돌리는 방법은 README 를 봐라.


# ══ 필수 ═════════════════════════════════════════════════════════════
#
# Google AI Studio 에서 발급한다 (https://aistudio.google.com/apikey).
# 기본 설정(config/models.yaml)은 세 역할을 전부 Gemini 로 쓴다:
#   임베딩       gemini-embedding-2      무료 티어 있음
#   사건 분석    gemini-2.5-flash-lite   무료 티어 있음
#   일일 종합    gemini-2.5-flash-lite   무료 티어 있음
#
# 무료 티어 한도를 넘기면 유료로 전환된다. 그래도 월 $4 수준이고,
# config/pipeline.yaml 의 max_daily_cost_usd 가 상한을 강제한다.
GEMINI_API_KEY=

# Cloudflare Pages 배포용. 대시보드에서 발급한다.
#   토큰 권한: Account → Cloudflare Pages → Edit
#   계정 ID  : 대시보드 우측 사이드바 또는 URL 의 해시값
# 이름은 Cloudflare 공식 문서와 wrangler 환경변수 규약을 그대로 따른다.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# ══ 계정이 필요 없는 것들 (참고) ══════════════════════════════════════
#
#   GDELT 2.0    뉴스 수집 — 인증 없음
#   매체 RSS     공개 피드 — 인증 없음
#   저장소       SQLite 파일 하나. 레포에 SQL 덤프로 커밋된다
#
# 가입할 곳은 GitHub · Google AI Studio · Cloudflare 세 곳이고, 전부 무료 티어다.


# ══ 선택: 품질안으로 올릴 때 ═════════════════════════════════════════
#
# config/models.yaml 의 event_analysis 를 anthropic 으로 바꾼 경우에만 필요하다.
# 월 $4 → $21.60 이 되지만 분석 품질이 올라간다.
ANTHROPIC_API_KEY=

# config/models.yaml 의 embedding 을 openai 로 되돌린 경우에만 필요하다.
OPENAI_API_KEY=


# ══ 선택: 규모가 커졌을 때 ═══════════════════════════════════════════
#
# 원문 아카이브를 Cloudflare R2 에 두고 싶을 때. 세 개가 모두 있어야 쓴다.
# 없으면 data/raw/ 에 로컬 저장하고, 그 파일은 커밋되지 않는다.
# GDELT 는 본문을 주지 않으므로 이 아카이브는 없어도 파이프라인이 완결된다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=news-lens

# site/worker/ 의 검색 API(Workers)는 위의 CLOUDFLARE_* 를 그대로 쓴다.
# 다만 토큰에 Workers Scripts → Edit 권한이 추가로 필요하다.
# 기본 구성에서는 Worker 를 배포하지 않는다.


# ══ 로컬 전용 ════════════════════════════════════════════════════════
# 설정 디렉토리를 바꿔 끼울 때 (테스트·오프라인 실행이 쓴다)
# NEWS_LENS_CONFIG_DIR=config
# SQLite 경로를 고정할 때
# NEWS_LENS_DB=news-lens.db
# SQL 덤프 경로를 바꿀 때
# NEWS_LENS_DUMP=data/news-lens.sql
