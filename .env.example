# news-lens 환경변수.
#
# 로컬: 이 파일을 .env 로 복사해 채운다. .env 는 절대 커밋하지 않는다.
# 운영: 아래 이름 그대로 GitHub 레포의 Settings → Secrets and variables →
#       Actions → Secrets 에 등록한다. 워크플로가 이 이름으로 참조한다.
#
# 키가 하나도 없어도 모든 step 은 --dry-run 으로 돌아간다.
# fixtures 로 전체를 돌리는 방법은 README 를 봐라.

# ── LLM ─────────────────────────────────────────────────────────────
# config/models.yaml 에서 쓰는 provider 의 키만 있으면 된다.

# event_analysis, daily_synthesis (기본값)
ANTHROPIC_API_KEY=sk-ant-...

# embedding
OPENAI_API_KEY=sk-...

# 저가안으로 갈아탈 때만 (models.yaml 의 provider 를 gemini 로 바꾼 경우)
GEMINI_API_KEY=

# ── 파생 데이터 (Turso / libSQL) ────────────────────────────────────
# 없으면 레포 루트의 news-lens.db (SQLite) 를 쓴다 — 로컬 개발용.
TURSO_DATABASE_URL=libsql://news-lens-<org>.turso.io
TURSO_AUTH_TOKEN=

# ── 원문 보관 (Cloudflare R2, S3 호환) ──────────────────────────────
# 세 개가 모두 있어야 R2 를 쓴다. 하나라도 없으면 data/raw/ 에 로컬 저장.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=news-lens

# ── 배포 (Cloudflare Pages / Workers) ───────────────────────────────
# Pages:Edit 와 Workers Scripts:Edit 권한이 필요하다.
CF_API_TOKEN=

# ── 로컬 전용 ───────────────────────────────────────────────────────
# 설정 디렉토리를 바꿔 끼울 때 (테스트·오프라인 실행이 쓴다)
# NEWS_LENS_CONFIG_DIR=config
# SQLite 경로를 고정할 때
# NEWS_LENS_DB=news-lens.db
