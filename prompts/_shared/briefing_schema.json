{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daily_synthesis",
  "description": "하루치 사건을 묶은 일일 브리핑. step7이 이 스키마로 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["헤드라인", "오늘의_3대_흐름", "지역별_요약", "주목할_신호"],
  "properties": {
    "헤드라인": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140,
      "description": "오늘 하루를 한 문장으로."
    },
    "오늘의_3대_흐름": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["제목", "설명", "관련사건"],
        "properties": {
          "제목": { "type": "string", "minLength": 4 },
          "설명": { "type": "string", "minLength": 30 },
          "관련사건": {
            "type": "array",
            "items": { "type": "string", "pattern": "^evt_[0-9]{8}_[0-9]{4}$" },
            "description": "사건 id. 없는 id를 지어내면 검증에서 걸린다."
          }
        }
      }
    },
    "지역별_요약": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["지역", "요약"],
        "properties": {
          "지역": { "type": "string" },
          "요약": { "type": "string", "minLength": 20 }
        }
      }
    },
    "주목할_신호": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["신호", "근거"],
        "properties": {
          "신호": { "type": "string" },
          "근거": { "type": "string" }
        }
      },
      "description": "아직 크게 다뤄지지 않았지만 지켜볼 만한 것. 없으면 빈 배열."
    }
  }
}
